  "item": [
    {
      "name": "1. Registrar Usuario Nuevo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El código de estado debe ser 201 Created o 400 (Si ya existe)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
              "});",
              "",
              "pm.test(\"El tiempo de respuesta es menor a 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre_usuario\": \"Tester Evaluacion\",\n    \"correo_electronico\": \"tester@medistock.cl\",\n    \"contrasena\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/usuarios/registro",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "usuarios",
            "registro"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Iniciar Sesión (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El código de estado debe ser 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"La respuesta debe contener la propiedad 'usuario'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('usuario');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
